<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>Label</key><string>com.signalmap.factory</string>
 <key>ProgramArguments</key><array>
  <string><local-path>/signalmap/.venv-research/bin/python</string>
  <string><local-path>/signalmap/research/factory/factory_scheduler.py</string>
  <string>--tick</string>
 </array>
 <key>WorkingDirectory</key><string><local-path>/signalmap/research/factory</string>
 <key>StartInterval</key><integer>3600</integer>
 <key>RunAtLoad</key><true/>
 <key>Nice</key><integer>19</integer>
 <key>StandardOutPath</key><string><local-path>/signalmap/research/factory/logs/factory_scheduler.out</string>
 <key>StandardErrorPath</key><string><local-path>/signalmap/research/factory/logs/factory_scheduler.err</string>
</dict></plist>
